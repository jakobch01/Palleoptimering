@model Pallet

<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.css" />
    <title>Rediger Palle</title>
</head>
<body>
    <h5 class="bg-primary text-white text-center m-2 p-2">Rediger Palle</h5>

    <form asp-action="Edit" method="post" class="m-2">
        <div asp-validation-summary="All" class="text-danger"></div>
        <input type="hidden" asp-for="Id" />

        <div class="form-group">
            <label asp-for="Description" class="form-label"></label>
            <input asp-for="Description" class="form-control" />
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Length" class="form-label"></label>
            <input asp-for="Length" class="form-control" />
            <span asp-validation-for="Length" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Width" class="form-label"></label>
            <input asp-for="Width" class="form-control" />
            <span asp-validation-for="Width" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Height" class="form-label"></label>
            <input asp-for="Height" class="form-control" />
            <span asp-validation-for="Height" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Group" class="form-label"></label>
            <select asp-for="Group" asp-items="Html.GetEnumSelectList<PalletGroup>()" class="form-control"></select>
            <span asp-validation-for="Group" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Type" class="form-label"></label>
            <select asp-for="Type" asp-items="Html.GetEnumSelectList<PalletType>()" class="form-control"></select>
            <span asp-validation-for="Type" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Weight" class="form-label"></label>
            <input asp-for="Weight" class="form-control" />
            <span asp-validation-for="Weight" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="MaxHeight" class="form-label"></label>
            <input asp-for="MaxHeight" class="form-control" />
            <span asp-validation-for="MaxHeight" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="MaxWeight" class="form-label"></label>
            <input asp-for="MaxWeight" class="form-control" />
            <span asp-validation-for="MaxWeight" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="Overhang" class="form-label"></label>
            <input asp-for="Overhang" class="form-control" />
            <span asp-validation-for="Overhang" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label asp-for="AvailableSpaces" class="form-label"></label>
            <input asp-for="AvailableSpaces" class="form-control" />
            <span asp-validation-for="AvailableSpaces" class="text-danger"></span>
        </div>

        <div class="form-check mt-2">
            <input asp-for="IsSpecial" class="form-check-input" type="checkbox" />
            <label asp-for="IsSpecial" class="form-check-label"></label>
        </div>

        <div class="form-group mt-2">
            <label asp-for="SpacingBetweenElements" class="form-label"></label>
            <input asp-for="SpacingBetweenElements" class="form-control" />
            <span asp-validation-for="SpacingBetweenElements" class="text-danger"></span>
        </div>

        <div class="form-check mt-2">
            <input asp-for="IsActive" class="form-check-input" type="checkbox" />
            <label asp-for="IsActive" class="form-check-label"></label>
        </div>

        <button type="submit" class="btn btn-primary mt-3">Gem</button>
        <a class="btn btn-secondary mt-3" asp-action="ListPallets" asp-controller="Home">Annuller</a>
    </form>
</body>
</html>
