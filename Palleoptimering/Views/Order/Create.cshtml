@model OrderViewModel

<h2 class="text-center my-4">Opret Ordre</h2>

<div class="container">
    <form asp-action="Create" method="post" class="card p-4 shadow-lg">
        <div class="mb-3">
            <label class="form-label">Kundens Navn:</label>
            <input type="text" asp-for="Customer" class="form-control" placeholder="Indtast kundens navn" required />
        </div>

        <h3 class="mt-4">Elementer</h3>
        <div id="elementsContainer" class="mb-3">
            @for (int i = 0; i < Model.Elements.Count; i++)
            {
                <div class="row g-3 mb-4 border p-3 rounded">
                    <div class="col-md-4">
                        <input type="text" asp-for="Elements[@i].Name" class="form-control" placeholder="Elementnavn" required />
                    </div>
                    <div class="col-md-4">
                        <input type="text" asp-for="Elements[@i].Series" class="form-control" placeholder="Serie" />
                    </div>
                    <div class="col-md-4">
                        <input type="number" asp-for="Elements[@i].Width" class="form-control" placeholder="Bredde (mm)" required />
                    </div>
                    <div class="col-md-4">
                        <input type="number" asp-for="Elements[@i].Height" class="form-control" placeholder="Højde (mm)" required />
                    </div>
                    <div class="col-md-4">
                        <input type="number" asp-for="Elements[@i].Depth" class="form-control" placeholder="Dybde (mm)" required />
                    </div>
                    <div class="col-md-4">
                        <input type="number" asp-for="Elements[@i].Weight" class="form-control" placeholder="Vægt (kg)" required />
                    </div>
                    <div class="col-md-4">
                        <select asp-for="Elements[@i].Rotation" class="form-select">
                            <option value="NotAllowed">Rotation: Nej</option>
                            <option value="Allowed">Rotation: Ja</option>
                            <option value="Required">Rotation: Skal</option>
                        </select>
                    </div>
                    <div class="col-md-4 form-check mt-2">
                        <input type="checkbox" asp-for="Elements[@i].RequiresSpecialPallet" class="form-check-input" />
                        <label class="form-check-label">Speciel palle</label>
                    </div>
                    <div class="col-md-4">
                        <input type="number" asp-for="Elements[@i].MaxElementsPerPallet" class="form-control" placeholder="Maks. antal pr. palle" />
                    </div>
                    <div class="col-md-4">
                        <input type="text" asp-for="Elements[@i].PalletType" class="form-control" placeholder="Type af palle" />
                    </div>
                    <div class="col-md-4 form-check mt-2">
                        <input type="checkbox" asp-for="Elements[@i].IsGeometric" class="form-check-input" />
                        <label class="form-check-label">Er geometrisk</label>
                    </div>
                    <div class="col-md-4">
                        <input type="text" asp-for="Elements[@i].OptimizationGroup" class="form-control" placeholder="Optimeringsgruppe" />
                    </div>
                </div>
            }
        </div>

        <button type="button" id="addElement" class="btn btn-outline-primary mb-3">Tilføj Element</button>
        <button type="submit" class="btn btn-success">Opret Ordre</button>
    </form>
</div>

<script>
    document.getElementById("addElement").addEventListener("click", function () {
        const container = document.getElementById("elementsContainer");
        const index = container.children.length;
        const div = document.createElement("div");
        div.className = "row g-3 mb-4 border p-3 rounded";

        div.innerHTML = `
                <div class="col-md-4">
                    <input type="text" name="Elements[${index}].Name" class="form-control" placeholder="Elementnavn" required />
                </div>
                <div class="col-md-4">
                    <input type="text" name="Elements[${index}].Mark" class="form-control" placeholder="Mærke" />
                </div>
                <div class="col-md-4">
                    <input type="text" name="Elements[${index}].Series" class="form-control" placeholder="Serie" />
                </div>
                <div class="col-md-4">
                    <input type="number" name="Elements[${index}].Width" class="form-control" placeholder="Bredde (mm)" required />
                </div>
                <div class="col-md-4">
                    <input type="number" name="Elements[${index}].Height" class="form-control" placeholder="Højde (mm)" required />
                </div>
                <div class="col-md-4">
                    <input type="number" name="Elements[${index}].Depth" class="form-control" placeholder="Dybde (mm)" required />
                </div>
                <div class="col-md-4">
                    <input type="number" name="Elements[${index}].Weight" class="form-control" placeholder="Vægt (kg)" required />
                </div>
                <div class="col-md-4">
                    <select name="Elements[${index}].Rotation" class="form-select">
                        <option value="NotAllowed">Rotation: Nej</option>
                        <option value="Allowed">Rotation: Ja</option>
                        <option value="Required">Rotation: Skal</option>
                    </select>
                </div>
                <div class="col-md-4 form-check mt-2">
                    <input type="checkbox" name="Elements[${index}].RequiresSpecialPallet" class="form-check-input" />
                    <label class="form-check-label">Speciel palle</label>
                </div>
                <div class="col-md-4">
                    <input type="number" name="Elements[${index}].MaxElementsPerPallet" class="form-control" placeholder="Maks. antal pr. palle" />
                </div>
                <div class="col-md-4">
                    <input type="text" name="Elements[${index}].PalletType" class="form-control" placeholder="Type af palle" />
                </div>
                <div class="col-md-4 form-check mt-2">
                    <input type="checkbox" name="Elements[${index}].IsGeometric" class="form-check-input" />
                    <label class="form-check-label">Er geometrisk</label>
                </div>
                <div class="col-md-4">
                    <input type="text" name="Elements[${index}].OptimizationGroup" class="form-control" placeholder="Optimeringsgruppe" />
                </div>
            `;
        container.appendChild(div);
    });
</script>
