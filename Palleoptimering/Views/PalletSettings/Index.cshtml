@using Palleoptimering.Models
@model Palleoptimering.Models.PalletSettings
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Pallepakning</title>
    <link rel="stylesheet" href="/lib/bootstrap/dist/css/bootstrap.css" />
</head>
<body>
    <form asp-action="CreatePalletSettings" method="post" class="m-2">
        <div asp-validation-summary="All" class="text-danger"></div>

        <div class="form-group">
            <label asp-for="MaxLayers" class="form-label"></label>
            <input asp-for="MaxLayers" class="form-control" />
        </div>

        <div class="form-group">
            <label asp-for="MaxSpace" class="form-label"></label>
            <input asp-for="MaxSpace" class="form-control" />
        </div>

        <div class="form-group">
            <label asp-for="MaxWeightAllowedToRotate" class="form-label"></label>
            <input asp-for="MaxWeightAllowedToRotate" class="form-control" />
        </div>

        <div class="form-group">
            <label asp-for="HeightWidthFactor" class="form-label"></label>
            <input asp-for="HeightWidthFactor" class="form-control" />
        </div>

        <div class="form-group">
            <label asp-for="HeightWidthFactorOnlyForSingleElements" class="form-label"></label>
            <input asp-for="HeightWidthFactorOnlyForSingleElements" class="form-check-input" type="checkbox" />
        </div>

        <div class="form-group">
            <label asp-for="MaxStackingHeight" class="form-label"></label>
            <input asp-for="MaxStackingHeight" class="form-control" />
        </div>

        <div class="form-group">
            <label asp-for="EndPlateAddition" class="form-label"></label>
            <input asp-for="EndPlateAddition" class="form-control" />
        </div>

        <div class="form-group">
            <label asp-for="MaxAllowedStackingWeight" class="form-label"></label>
            <input asp-for="MaxAllowedStackingWeight" class="form-control" />
        </div>

        <div class="form-group">
            <label asp-for="AllowRotationWhenExceedingMaxHeight" class="form-label"></label>
            <input asp-for="AllowRotationWhenExceedingMaxHeight" class="form-check-input" type="checkbox" />
        </div>

        <div class="form-group">
            <label asp-for="RowDistribution" class="form-label"></label>
            <select asp-for="RowDistribution" class="form-control" asp-items="Html.GetEnumSelectList<RowDistributionType>()"></select>
        </div>

        <div class="form-group">
            <label asp-for="MaxOverhang" class="form-label"></label>
            <input asp-for="MaxOverhang" class="form-control" />
        </div>

        <div class="form-group">
            <label asp-for="SpacingBetweenElements" class="form-label"></label>
            <input asp-for="SpacingBetweenElements" class="form-control" />
        </div>

        <button type="submit" class="btn btn-primary mt-3">Gem</button>
        <button type="button" class="btn btn-secondary mt-3" onclick="location.href='@Url.Action("Index", "Home")'">Afbryd</button>
    </form>
</body>
</html>
